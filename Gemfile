source "https://rubygems.org"

# Local development only. GitHub Actions builds and deploys the site with the
# official `jekyll-build-pages` image, which uses GitHub Pages' own pinned gems.
gem "jekyll", "~> 4.4"

# The theme configured in _config.yml. GitHub Pages also ships this theme.
gem "jekyll-theme-minimal", "~> 0.2"

# Required to run `bundle exec jekyll serve` on Ruby 3+.
gem "webrick", "~> 1.9"
